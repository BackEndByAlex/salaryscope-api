# Dependencies — reinstalled inside the image via npm ci.
node_modules

# Local secrets and environment configuration — never go into a build context.
.env
keys/private.pem

# Version control internals.
.git
.gitignore

# AI tooling configuration.
.claude

# Logs produced during local development.
*.log

# Build output (not used in this project but excluded for safety).
dist

# Local test collections and raw data files.
postman

# Key generation script — not needed at runtime.
scripts

# Documentation files — not needed at runtime.
README.md
ISSUES.md
ROUTE_MAP.md
TESTING.md

# Docs build artifacts — excluded from API image context.
# Note: docs/ itself is NOT excluded because Dockerfile.docs needs it.
docs/node_modules
docs/build
docs/.docusaurus

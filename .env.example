# PostgreSQL container credentials — used by Docker Compose
POSTGRES_USER=you_can_change_this
POSTGRES_PASSWORD=something_secret
POSTGRES_DB=jobs_salary

# Full database URL — used when running Prisma commands directly on the host
# (npm run db:migrate, db:seed, db:studio)
# localhost:5432 because the dev compose exposes Postgres on that port
# Must match POSTGRES_USER, POSTGRES_PASSWORD, and POSTGRES_DB above
DATABASE_URL=postgresql://you_can_change_this:something_secret@localhost:5432/jobs_salary

# Port the API listens on (when running outside Docker with npm run dev)
PORT=YourPort Here

# Comma-separated list of browser origins allowed to call the API
# Dev:  http://localhost:5173
# Prod: https://your-dashboard.lnu.se
ALLOWED_ORIGINS=http://localhost:5173,https://your-dashboard.lnu.se

# GitHub OAuth App credentials (register at github.com/settings/developers)
# Callback URL to set in the GitHub App: <your-frontend-url>/auth/callback
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret
GITHUB_REDIRECT_URI=http://localhost:5173/auth/callback

# Google OAuth App credentials (console.cloud.google.com → APIs & Services → Credentials)
# Authorized redirect URI: <your-frontend-url>/auth/callback
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:5173/auth/callback

# Secret used to sign OAuth state cookies — must be a long random string
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
COOKIE_SECRET=replace_with_a_long_random_secret

# Elasticsearch — used by the search feature
# In Docker: http://elasticsearch:9200  |  Local: http://localhost:9200
ELASTICSEARCH_URL=http://localhost:9200

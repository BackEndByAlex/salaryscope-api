      "name": "01 - Auth",
      "item": [
        {
          "name": "Register",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "const id = Math.random().toString(36).substring(2, 10);",
                  "pm.collectionVariables.set('email', `test_${id}@example.com`);",
                  "pm.collectionVariables.set('password', `Pass_${id}!`);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "",
                  "pm.test('Returns user on register', function () {",
                  "  pm.expect(json.data.register.user.email).to.eql(pm.collectionVariables.get('email'));",
                  "  pm.expect(json.data.register.user.id).to.be.a('string');",
                  "});",
                  "",
                  "pm.collectionVariables.set('userId', json.data.register.user.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}", "host": ["{{baseUrl}}"] },
            "body": {
              "mode": "graphql",
              "graphql": {
                "query": "mutation Register($input: RegisterInput!) {\n  register(input: $input) {\n    user { id email }\n  }\n}",
                "variables": "{ \"input\": { \"email\": \"{{email}}\", \"password\": \"{{password}}\" } }"
              }
            }
          }
        },

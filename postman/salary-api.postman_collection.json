{
  "info": {
    "name": "SalaryScope API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "email", "value": "" },
    { "key": "password", "value": "" },
    { "key": "token", "value": "" },
    { "key": "userId", "value": "" },
    { "key": "countryId", "value": "" },
    { "key": "countryName", "value": "" },
    { "key": "jobId", "value": "" },
    { "key": "recordId", "value": "" }
  ],
  "item": [
    {
      "name": "01 - Auth",
      "item": [
        {
          "name": "Register",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "const id = Math.random().toString(36).substring(2, 10);",
                  "pm.collectionVariables.set('email', `test_${id}@example.com`);",
                  "pm.collectionVariables.set('password', `Pass_${id}!`);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "",
                  "pm.test('Returns token and user', function () {",
                  "  pm.expect(json.data.register.token).to.be.a('string');",
                  "  pm.expect(json.data.register.user.email).to.eql(pm.collectionVariables.get('email'));",
                  "});",
                  "",
                  "pm.collectionVariables.set('token', json.data.register.token);",
                  "pm.collectionVariables.set('userId', json.data.register.user.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}", "host": ["{{baseUrl}}"] },
            "body": {
              "mode": "graphql",
              "graphql": {
                "query": "mutation Register($input: RegisterInput!) {\n  register(input: $input) {\n    token\n    user { id email }\n  }\n}",
                "variables": "{ \"input\": { \"email\": \"{{email}}\", \"password\": \"{{password}}\" } }"
              }
            }
          }
        },
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "",
                  "pm.test('Returns token and user', function () {",
                  "  pm.expect(json.data.login.token).to.be.a('string');",
                  "  pm.expect(json.data.login.user.email).to.eql(pm.collectionVariables.get('email'));",
                  "});",
                  "",
                  "pm.collectionVariables.set('token', json.data.login.token);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}", "host": ["{{baseUrl}}"] },
            "body": {
              "mode": "graphql",
              "graphql": {
                "query": "mutation Login($input: LoginInput!) {\n  login(input: $input) {\n    token\n    user { id email }\n  }\n}",
                "variables": "{ \"input\": { \"email\": \"{{email}}\", \"password\": \"{{password}}\" } }"
              }
            }
          }
        },
        {
          "name": "Register - duplicate email",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "",
                  "pm.test('Returns BAD_USER_INPUT error', function () {",
                  "  pm.expect(json.errors).to.be.an('array');",
                  "  pm.expect(json.errors[0].extensions.code).to.eql('BAD_USER_INPUT');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}", "host": ["{{baseUrl}}"] },
            "body": {
              "mode": "graphql",
              "graphql": {
                "query": "mutation Register($input: RegisterInput!) {\n  register(input: $input) {\n    token\n    user { id email }\n  }\n}",
                "variables": "{ \"input\": { \"email\": \"{{email}}\", \"password\": \"{{password}}\" } }"
              }
            }
          }
        },
        {
          "name": "Register - short password",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "",
                  "pm.test('Returns BAD_USER_INPUT error', function () {",
                  "  pm.expect(json.errors).to.be.an('array');",
                  "  pm.expect(json.errors[0].extensions.code).to.eql('BAD_USER_INPUT');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}", "host": ["{{baseUrl}}"] },
            "body": {
              "mode": "graphql",
              "graphql": {
                "query": "mutation Register($input: RegisterInput!) {\n  register(input: $input) {\n    token\n    user { id email }\n  }\n}",
                "variables": "{ \"input\": { \"email\": \"short@example.com\", \"password\": \"123\" } }"
              }
            }
          }
        },
        {
          "name": "Login - wrong password",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "",
                  "pm.test('Returns BAD_USER_INPUT error', function () {",
                  "  pm.expect(json.errors).to.be.an('array');",
                  "  pm.expect(json.errors[0].extensions.code).to.eql('BAD_USER_INPUT');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}", "host": ["{{baseUrl}}"] },
            "body": {
              "mode": "graphql",
              "graphql": {
                "query": "mutation Login($input: LoginInput!) {\n  login(input: $input) {\n    token\n    user { id email }\n  }\n}",
                "variables": "{ \"input\": { \"email\": \"{{email}}\", \"password\": \"wrongpassword123\" } }"
              }
            }
          }
        },
        {
          "name": "Me - authenticated",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "",
                  "pm.test('Returns current user', function () {",
                  "  pm.expect(json.data.me.email).to.eql(pm.collectionVariables.get('email'));",
                  "  pm.expect(json.data.me.id).to.be.a('string');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": { "raw": "{{baseUrl}}", "host": ["{{baseUrl}}"] },
            "body": {
              "mode": "graphql",
              "graphql": {
                "query": "query Me {\n  me {\n    id\n    email\n    createdAt\n  }\n}",
                "variables": ""
              }
            }
          }
        },
        {
          "name": "Me - no token",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "",
                  "pm.test('Returns UNAUTHENTICATED error', function () {",
                  "  pm.expect(json.errors).to.be.an('array');",
                  "  pm.expect(json.errors[0].extensions.code).to.eql('UNAUTHENTICATED');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}", "host": ["{{baseUrl}}"] },
            "body": {
              "mode": "graphql",
              "graphql": {
                "query": "query Me {\n  me {\n    id\n    email\n    createdAt\n  }\n}",
                "variables": ""
              }
            }
          }
        }
      ]
    },
    {
      "name": "02 - Public Queries",
      "item": [
        {
          "name": "Countries list",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "",
                  "pm.test('Returns paginated countries', function () {",
                  "  pm.expect(json.data.countries.countries).to.be.an('array');",
                  "  pm.expect(json.data.countries.totalCount).to.be.above(0);",
                  "  pm.expect(json.data.countries.hasNextPage).to.be.a('boolean');",
                  "});",
                  "",
                  "const first = json.data.countries.countries[0];",
                  "pm.collectionVariables.set('countryId', first.id);",
                  "pm.collectionVariables.set('countryName', first.name);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}", "host": ["{{baseUrl}}"] },
            "body": {
              "mode": "graphql",
              "graphql": {
                "query": "query Countries {\n  countries {\n    countries { id name }\n    totalCount\n    hasNextPage\n  }\n}",
                "variables": ""
              }
            }
          }
        },
        {
          "name": "Country by ID",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "",
                  "pm.test('Returns the correct country', function () {",
                  "  pm.expect(json.data.country.id).to.eql(pm.collectionVariables.get('countryId'));",
                  "  pm.expect(json.data.country.name).to.eql(pm.collectionVariables.get('countryName'));",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}", "host": ["{{baseUrl}}"] },
            "body": {
              "mode": "graphql",
              "graphql": {
                "query": "query Country($id: ID!) {\n  country(id: $id) {\n    id\n    name\n  }\n}",
                "variables": "{ \"id\": \"{{countryId}}\" }"
              }
            }
          }
        },
        {
          "name": "Country - not found",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "",
                  "pm.test('Returns NOT_FOUND error', function () {",
                  "  pm.expect(json.errors).to.be.an('array');",
                  "  pm.expect(json.errors[0].extensions.code).to.eql('NOT_FOUND');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}", "host": ["{{baseUrl}}"] },
            "body": {
              "mode": "graphql",
              "graphql": {
                "query": "query Country($id: ID!) {\n  country(id: $id) {\n    id\n    name\n  }\n}",
                "variables": "{ \"id\": \"999999\" }"
              }
            }
          }
        },
        {
          "name": "Job Categories list",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "",
                  "pm.test('Returns paginated job categories', function () {",
                  "  pm.expect(json.data.jobCategories.jobCategories).to.be.an('array');",
                  "  pm.expect(json.data.jobCategories.totalCount).to.be.above(0);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}", "host": ["{{baseUrl}}"] },
            "body": {
              "mode": "graphql",
              "graphql": {
                "query": "query JobCategories {\n  jobCategories {\n    jobCategories { id name jobCount }\n    totalCount\n    hasNextPage\n  }\n}",
                "variables": ""
              }
            }
          }
        }
      ]
    }
  ]
}

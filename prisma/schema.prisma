// This Prisma schema defines the data model for the salary records application. 
// It includes models for countries, job categories, jobs, companies, salary records, and users. 
// The relationships between these models are set up to allow for efficient querying and data integrity.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Country {
  id              Int            @id @default(autoincrement())
  name            String         @unique
  employeeRecords SalaryRecord[] @relation("EmployeeCountry")
  companyRecords  SalaryRecord[] @relation("CompanyCountry")
  companies       Company[]
  cities          City[]
}

model City {
  id        Int            @id @default(autoincrement())
  name      String
  state     String?
  countryId Int
  country   Country        @relation(fields: [countryId], references: [id])
  records   SalaryRecord[]

  @@unique([name, state, countryId])
}

model JobCategory {
  id   Int    @id @default(autoincrement())
  name String @unique
  jobs Job[]
}

model Job {
  id         Int          @id @default(autoincrement())
  title      String
  categoryId Int?
  category   JobCategory? @relation(fields: [categoryId], references: [id])
  roles      String?
  records    SalaryRecord[]

  @@unique([title, categoryId])
}

model Company {
  id        Int            @id @default(autoincrement())
  name      String         @unique
  rating    Decimal?       @db.Decimal(3, 1)
  countryId Int?
  country   Country?       @relation(fields: [countryId], references: [id])
  records   SalaryRecord[]
}

model SalaryRecord {
  id                 Int      @id @default(autoincrement())

  // Always present
  salary             Decimal  @db.Decimal(12, 2)
  source             String

  // Dataset A only
  salaryInUsd        Decimal? @db.Decimal(12, 2)
  salaryCurrency     String?
  workYear           Int?
  experienceLevel    String?
  employmentType     String?
  workSetting        String?
  companySize        String?

  // Datasets B and C only
  salariesReported   Int?

  // Dataset B only
  employmentStatus   String?

  // Relations
  jobId              Int
  job                Job      @relation(fields: [jobId], references: [id])

  employeeCountryId  Int?
  employeeCountry    Country? @relation("EmployeeCountry", fields: [employeeCountryId], references: [id])

  companyCountryId   Int?
  companyCountry     Country? @relation("CompanyCountry", fields: [companyCountryId], references: [id])

  companyId          Int?
  company            Company? @relation(fields: [companyId], references: [id])

  cityId             Int?
  city               City?    @relation(fields: [cityId], references: [id])

  createdBy          Int?
  createdByUser      User?    @relation(fields: [createdBy], references: [id])

  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([jobId])
  @@index([employeeCountryId])
  @@index([companyCountryId])
  @@index([companyId])
  @@index([cityId])
  @@index([workYear])
  @@index([experienceLevel])
}

model User {
  id            Int            @id @default(autoincrement())
  email         String         @unique
  passwordHash  String?
  githubId      String?        @unique
  googleId      String?        @unique
  createdAt     DateTime       @default(now())
  salaryRecords SalaryRecord[]
}
